{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/facilities",
      "destination": "/servicos",
      "permanent": true
    },
    {
      "source": "/facilities/crm",
      "destination": "/crm",
      "permanent": true
    },
    {
      "source": "/facilities/atendimento",
      "destination": "/atendimento",
      "permanent": true
    },
    {
      "source": "/facilities/atendimento/solicitar",
      "destination": "/atendimento/solicitar",
      "permanent": true
    },
    {
      "source": "/app-colaborador",
      "destination": "/colaborador",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/colaborador",
      "destination": "/facilities/colaborador"
    },
    {
      "source": "/servicos",
      "destination": "/facilities"
    },
    {
      "source": "/crm",
      "destination": "/facilities/crm"
    },
    {
      "source": "/atendimento",
      "destination": "/facilities/atendimento"
    },
    {
      "source": "/atendimento/solicitar",
      "destination": "/facilities/atendimento/solicitar"
    },
    {
      "source": "/crm/manifest.webmanifest",
      "destination": "/facilities/crm/manifest.webmanifest"
    },
    {
      "source": "/atendimento/solicitar/manifest.webmanifest",
      "destination": "/facilities/atendimento/solicitar/manifest.webmanifest"
    },
    {
      "source": "/colaborador/manifest.webmanifest",
      "destination": "/facilities/colaborador/manifest.webmanifest"
    }
  ]
}
